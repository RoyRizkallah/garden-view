# HTTPS for Garden View. Caddy obtains and renews the Let's Encrypt certificate for $DOMAIN on
# its own (the domain's DNS A record must point at this server, ports 80 and 443 open).
{$DOMAIN} {
	encode zstd gzip

	# a listing arrives with its photos in one request of up to ~40 MB
	request_body {
		max_size 50MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	reverse_proxy app:4000
}

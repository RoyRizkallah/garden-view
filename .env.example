# Copy to .env on the server (never commit .env) and fill in every value.

# The site's domain, without https:// — its DNS A record must point at this server.
DOMAIN=gardenview.example

# Database password: long and random, e.g.  openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login sessions: at least 32 random characters, e.g.  openssl rand -hex 48
# Changing it signs everyone out.
JWT_SECRET=

# Optional: Google Maps embed key for the location maps (restrict it to your domain in the
# Google Cloud console). Without it the maps show "Map unavailable".
GOOGLE_MAPS_API_KEY=

# Optional: creates the first admin on start while the database has none (at least 12
# characters). Remove both lines once you have signed in and changed the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  ACCOUNTANT
  ADMIN
}

enum RequestType {
  ISSUE
  RENOVATION
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum VoteStatus {
  OPEN
  CLOSED
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

enum ChargeStatus {
  DUE
  PAID
  OVERDUE
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ServiceCategory {
  ELECTRICIAN
  PLUMBER
  AIR_CONDITIONING
  CLEANING
  HANDYMAN
  OTHER
}

enum ServiceStatus {
  SUBMITTED
  IN_REVIEW
  SCHEDULED
  DONE
  DECLINED
}

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  PENDING
  REVIEWING
  APPROVED
  DECLINED
  WITHDRAWN
}

model Unit {
  id             String   @id @default(cuid())
  block          String
  number         String
  registrationNo String?
  sizeSqm        Float?
  floorPlanUrl   String?
  ownerName      String?
  ownerPhone     String?
  ownerEmail     String?
  dataNotes      String?
  createdAt      DateTime @default(now())

  account         Account?
  charges         Charge[]
  requests        Request[]
  bookings        AmenityBooking[]
  listingRequests ListingRequest[]
  serviceRequests ServiceRequest[]

  @@unique([block, number])
}

model BlockImage {
  id        String   @id @default(cuid())
  block     String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ListingRequest {
  id            String        @id @default(cuid())
  unitId        String
  unit          Unit          @relation(fields: [unitId], references: [id])
  accountId     String
  account       Account       @relation(fields: [accountId], references: [id])
  type          ListingType
  askingPrice   Float?
  availableFrom DateTime?
  leaseDuration String?
  furnished     String?
  /// Shown on the public listing once approved.
  description   String?
  /// For building management only; never shown publicly.
  notes         String?
  status        ListingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  photos        ListingPhoto[]

  @@index([status])
  @@index([unitId])
}

/// A photo the owner attached to their listing, stored under server/uploads/listings/<listingId>/.
model ListingPhoto {
  id               String         @id @default(cuid())
  listingRequestId String
  listingRequest   ListingRequest @relation(fields: [listingRequestId], references: [id], onDelete: Cascade)
  url              String
  width            Int
  height           Int
  order            Int            @default(0)
  createdAt        DateTime       @default(now())

  @@index([listingRequestId])
}

model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  unitId       String?  @unique
  unit         Unit?    @relation(fields: [unitId], references: [id])
  createdAt    DateTime @default(now())

  votesCast       VoteResponse[]
  requests        Request[]
  bookings        AmenityBooking[]
  listingRequests ListingRequest[]
  serviceRequests ServiceRequest[]
}

model Charge {
  id         String       @id @default(cuid())
  unitId     String
  unit       Unit         @relation(fields: [unitId], references: [id])
  period     String
  amountDue  Float
  amountPaid Float        @default(0)
  status     ChargeStatus @default(DUE)
  dueDate    DateTime
  createdAt  DateTime     @default(now())
}

model Project {
  id          String    @id @default(cuid())
  title       String
  category    String
  description String?
  progressPct Int       @default(0)
  startDate   DateTime?
  eta         DateTime?
  budget      Float?
  contractor  String?
  createdAt   DateTime  @default(now())

  milestones ProjectMilestone[]
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  completedAt DateTime?
  order     Int     @default(0)
}

model Vote {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      VoteStatus @default(OPEN)
  closesAt    DateTime
  createdAt   DateTime   @default(now())

  responses VoteResponse[]
}

model VoteResponse {
  id        String     @id @default(cuid())
  voteId    String
  vote      Vote       @relation(fields: [voteId], references: [id])
  accountId String
  account   Account    @relation(fields: [accountId], references: [id])
  unitId    String
  choice    VoteChoice
  createdAt DateTime   @default(now())

  @@unique([voteId, unitId])
}

model Request {
  id          String        @id @default(cuid())
  type        RequestType
  category    String
  description String
  status      RequestStatus @default(OPEN)
  unitId      String
  unit        Unit          @relation(fields: [unitId], references: [id])
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  interest  String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Document {
  id        String   @id @default(cuid())
  title     String
  category  String
  fileUrl   String
  createdAt DateTime @default(now())
}

model AmenitySpace {
  id       String           @id @default(cuid())
  name     String
  bookings AmenityBooking[]
}

model AmenityBooking {
  id        String       @id @default(cuid())
  spaceId   String
  space     AmenitySpace @relation(fields: [spaceId], references: [id])
  unitId    String
  unit      Unit         @relation(fields: [unitId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  date      DateTime
  startTime String
  endTime   String
  createdAt DateTime     @default(now())
}

/// A resident's request for an outside trade. Garden View coordinates it; the provider is independent.
model ServiceRequest {
  id             String          @id @default(cuid())
  category       ServiceCategory
  description    String
  timing         String?
  status         ServiceStatus   @default(SUBMITTED)
  managementNote String?
  unitId         String
  unit           Unit            @relation(fields: [unitId], references: [id])
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([unitId])
}

/// An owners' meeting, with the agenda residents read beforehand and the notes published afterwards.
model Meeting {
  id        String        @id @default(cuid())
  title     String
  startsAt  DateTime
  location  String?
  summary   String?
  notes     String?
  status    MeetingStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agenda    AgendaItem[]

  @@index([startsAt])
}

model AgendaItem {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title     String
  detail    String?
  order     Int     @default(0)

  @@index([meetingId])
}
